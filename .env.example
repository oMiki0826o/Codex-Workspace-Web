# Comma-separated allowed parent directories. Use paths on your own host.
ALLOWED_PROJECT_ROOTS=/home/your-user/projects
DEFAULT_PROJECT_PATH=/home/your-user/projects
CODEX_BIN=codex
CODEX_WEB_DATA_DIR=/home/your-user/.local/share/codex-webui
# Optional cap (per-job / event persisted data are bounded)
CODEX_WEB_MAX_ACTIVE=2
